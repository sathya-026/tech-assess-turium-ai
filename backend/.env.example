# Providers are selected independently. "openai" or "stub".
# stub = keyless + deterministic, for local runs and CI.
INFERENCE_PROVIDER=openai
EMBEDDING_PROVIDER=openai

OPENAI_API_KEY=sk-...
GENERATION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

DATABASE_URL=sqlite+aiosqlite:///./data/rag.db

CHUNK_SIZE=2000
CHUNK_OVERLAP=200
DEFAULT_TOP_K=5
CANDIDATES_PER_RETRIEVER=50
RAG_MIN_SIMILARITY=0.20
MEMORY_MAX_MESSAGES=20
